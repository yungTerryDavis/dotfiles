// -*- mode: jsonc -*-
{
    // https://github.com/Alexays/Waybar/wiki/Configuration
    "layer": "bottom",
    "position": "top",
    "spacing": 4,
    "modules-left": [
        "hyprland/workspaces",
        "hyprland/window"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "custom/launcher",
        "mpd",
        "pulseaudio",
        "bluetooth",
        "network",
        "hyprland/language",
        "battery",
        "tray"
    ],
    // Modules configuration
    "hyprland/workspaces": {
        "active-only": false,
        "on-click": "hyprctl dispatch workspace {id}"
    },
    "hyprland/window": {},
    "clock": {
        "format": "{:%H:%M | %a, %d %b (%V)}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },
    "custom/launcher": {
        "format": " ",
        "tooltip": false,
        "on-click": "wofi -show drun"
    },
    "mpd": {
        "server": "/home/ngumbk/.local/share/mpd/socket",
        "format": "{stateIcon}({elapsedTime:%M:%S}/{totalTime:%M:%S}) ",
        "format-disconnected": "Disconnected ",
        "format-stopped": "Stopped ",
        "tooltip-format": "Vol: {volume}%\nTrack: {artist} - {title}\nAlbum: {album}\nPos: (({songPosition}/{queueLength}))",
        "unknown-tag": "N/A",
        "interval": 5,
        "on-click": "rmpc togglepause",
        "on-click-right": "rmpc next",
        "on-scroll-up": "rmpc volume +5",
        "on-scroll-down": "rmpc volume -5",
        "state-icons": {
            "paused": "",
            "playing": ""
        }
    },
    "pulseaudio": { // icons
        "scroll-step": 5,
        "format": "{icon}  {volume}%",
        "tooltip-format": "Vol: {volume}%\nMicro: {format_source}",
        "format-muted": "󰝟 Mute all chat √",
        "format-bluetooth": "{icon}   {volume}%",
        "format-bluetooth-muted": "󰝟  Mute all chat √",
        "format-source": "",
        "format-source-muted": "",
        "format-icons": {
            "default": [
                "",
                ""
            ]
        },
        "on-click": "pavucontrol"
    },
    "bluetooth": {
        "format-no-controller": " down", // Service down
        "format-disabled": " disabled",
        "format-off": "  Off", //
        "format-on": " On", // Service up, disconnected
        "format-connected": " Conn" // Service up, connected
    },
    "network": { // icons
        "format-wifi": "{icon}",
        "format-disconnected": "Disconnected ⚠", // add icon for disconnected
        "format-alt": "{essid} ({signalStrength}%) {ifname}: {ipaddr}/{cidr}",
        "format-icons": [
            ""
        ] // add icons
    },
    "hyprland/language": {
        "format": " {}",
        "format-en": "US",
        "format-ru": "RU"
    },
    "battery": { // icons and css
        "states": {
            // 100-95 - make green
            // "good": 95,  // make white
            "warning": 30, // make yellow
            "critical": 15
        },
        "format": "{capacity}% {icon}",
        "format-full": "{capacity}% {icon}",
        "format-charging": "{capacity}% {icon} ", // find icons
        "format-plugged": "{capacity}% ",
        "format-alt": "{time} {icon}",
        // "format-good": "", // An empty format will hide the module
        // "format-full": "",
        "format-icons": [
            "",
            "",
            "",
            "",
            ""
        ]
    },
    "tray": {
        "spacing": 10
    }
}